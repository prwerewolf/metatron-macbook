#!/usr/bin/env bash
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
while read -r local_ref local_oid remote_ref remote_oid; do
    if [[ "$local_oid" =~ ^0+$ ]]; then
        continue
    fi
    # Check every ancestor, including on a new branch. Old clones cannot silently
    # reintroduce the history that was removed for publication.
    python3 -B scripts/privacy_check.py --history --ref "$local_oid"
done
